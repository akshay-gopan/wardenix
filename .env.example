# Wardenix — environment configuration (copy to .env and adjust)
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
POSTGRES_USER=wardenix
POSTGRES_PASSWORD=wardenix_dev_pw_change_me
POSTGRES_DB=wardenix
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Async SQLAlchemy URL used by the gateway at runtime.
# (Compose builds this from the POSTGRES_* vars; override only for local dev.)
# DATABASE_URL=postgresql+asyncpg://wardenix:wardenix_dev_pw_change_me@db:5432/wardenix

# --- Security ---------------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
WARDENIX_JWT_SECRET=dev-only-insecure-secret-change-me
WARDENIX_JWT_ALGORITHM=HS256
WARDENIX_ACCESS_TOKEN_TTL_MINUTES=30

# First admin bootstrapped on startup if no users exist.
WARDENIX_BOOTSTRAP_ADMIN_EMAIL=admin@wardenix.local
WARDENIX_BOOTSTRAP_ADMIN_PASSWORD=changeme-admin

# --- Gateway behaviour ------------------------------------------------------
# Decision when no policy rule matches: deny | require_approval (secure default: deny)
WARDENIX_DEFAULT_ACTION=deny
# Seconds a pending approval stays valid before expiring.
WARDENIX_APPROVAL_TTL_SECONDS=900
# Bounded long-poll window (seconds) before returning approval_required on the first call.
WARDENIX_APPROVAL_LONGPOLL_SECONDS=2
# Per-call upstream timeout (seconds).
WARDENIX_UPSTREAM_TIMEOUT_SECONDS=30
# Max concurrent in-flight tool calls per agent.
WARDENIX_AGENT_CONCURRENCY=8
# Max serialized tool-call argument payload size (bytes).
WARDENIX_MAX_ARGS_BYTES=262144

# --- CORS (dashboard origin) ------------------------------------------------
WARDENIX_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Logging ----------------------------------------------------------------
WARDENIX_LOG_LEVEL=INFO
